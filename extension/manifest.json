{
  "manifest_version": 3,
  "name": "LernKarte",
  "description": "Herhangi bir web sayfasında seçtiğin Almanca kelimeyi tek tıkla LernKarte sözlüğüne ekle.",
  "version": "0.2.0",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "LernKarte'ye ekle"
  },
  "background": {
    "service_worker": "dist/background.js"
  },
  "permissions": [
    "contextMenus",
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "https://bsfaiaifmoaammmenhhq.supabase.co/*",
    "https://lernkartee.vercel.app/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "dist/content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://lernkartee.vercel.app/*"
      ],
      "js": [
        "dist/auth-bridge.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "commands": {
    "add-selection": {
      "suggested_key": {
        "default": "Ctrl+Shift+E",
        "mac": "Command+Shift+E"
      },
      "description": "Seçili kelimeyi LernKarte'ye ekle"
    }
  }
}
